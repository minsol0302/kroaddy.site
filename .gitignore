# --- 프로젝트 루트 .gitignore ---
# 시블링 폴더들의 .env 파일 무시

# AI 서비스
ai.kroaddy.site/.env
ai.kroaddy.site/**/.env
ai.kroaddy.site/services/**/.env

# Feed 서비스
feed.kroaddy.site/.env
feed.kroaddy.site/**/.env

# RAG 서비스
rag.kroaddy.site/.env
rag.kroaddy.site/**/.env

# API 서비스
api.kroaddy.site/.env
api.kroaddy.site/**/.env
api.kroaddy.site/services/**/.env
api.kroaddy.site/gateway/.env

# Web 서비스
www.kroaddy.site/.env
www.kroaddy.site/**/.env
www.kroaddy.site/.env.local
www.kroaddy.site/.env.*.local

# 모든 .kroaddy.site 폴더의 .env 파일
*.kroaddy.site/.env
*.kroaddy.site/**/.env

